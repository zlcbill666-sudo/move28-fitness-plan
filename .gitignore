# Raw capture, third-party previews, motion exports, Blender sources, caches,
# and generated renders stay ignored by default. Add one exact !path rule only
# after that specific original-3D source has passed provenance review.

# Interpreter and operating-system caches.
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db
